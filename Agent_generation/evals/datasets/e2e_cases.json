        ]
      },
      {
        "id": "ip",
        "name": "知识产权归属",
        "patterns": [
          "知识产权"
        ]
      },
      {
        "id": "brand",
        "name": "品牌保护",
        "patterns": [
          "品牌|商誉|声誉"
        ]
      },
      {
        "id": "confidential",
        "name": "保密",
        "patterns": [
          "保密"
        ]
      },
      {
        "id": "breach",
        "name": "违约责任",
        "patterns": [
          "违约责任|违约金"
        ]
      },
      {
        "id": "termination",
        "name": "解除/终止",
        "patterns": [
          "解除|终止"
        ]
      },
      {
        "id": "dispute",
        "name": "争议解决",
        "patterns": [
