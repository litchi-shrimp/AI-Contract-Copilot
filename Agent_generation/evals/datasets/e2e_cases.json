        ]
      },
      {
        "id": "confidential",
        "name": "保密",
        "patterns": [
          "保密"
        ]
      },
      {
        "id": "ip",
        "name": "知识产权",
        "patterns": [
          "知识产权"
        ]
      },
      {
        "id": "breach",
        "name": "违约责任",
        "patterns": [
          "违约责任|违约金"
        ]
      },
      {
        "id": "termination",
        "name": "解除/终止",
        "patterns": [
          "解除|终止"
        ]
      },
      {
        "id": "force_majeure",
        "name": "不可抗力",
        "patterns": [
          "不可抗力"
        ]
      },
      {
        "id": "dispute",
        "name": "争议解决",
        "patterns": [
          "争议解决|争议的解决|仲裁"
        ]
      }
    ],
    "special_requirements": [
      "7×24小时响应，一级故障2小时内响应、8小时内恢复",
      "乙方每月提交运维报告",
      "服务可用率不低于99.9%，未达标按当季服务费的5%扣减",
      "数据保密，保密期限为合同终止后3年",
      "违约金为合同总额的20%",
      "争议提交北京仲裁委员会仲裁",
      "年服务费36万元，按季度末每季支付9万元"
