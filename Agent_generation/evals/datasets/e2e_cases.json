    "special_requirements": [
      "授权素材为手游的角色形象、宣传视频、游戏截图",
      "授权地域限江苏，期限约一年",
      "仅限推广用途，不得转授权",
      "费用按推广效果分成结算",
      "被授权方违法或损害品牌须承担责任",
      "未公开新版本内容的保密条款"
    ]
  },
  {
    "id": "equipment_purchase",
    "title": "数控机床设备采购合同（苏州·企业对企业）",
    "contract_family": "买卖",
    "requirement": "我方是买方（企业），向供应商（企业）采购10台数控机床，单价28万元，总价280万元，适用地区江苏苏州，合同复杂度标准型。付款方式：合同签订后7日内支付30%预付款，到货验收合格后支付60%，剩余10%作为质保金在质保期满后支付；质保期12个月。交货期为合同签订后60日内，供应商送货至买方工厂并负责安装调试。逾期交货每日按合同总价的0.05%支付违约金，最高不超过总价的10%；验收不合格买方有权要求退换货。",
    "elements": [
      {
        "id": "qty",
        "desc": "数量 10 台",
        "patterns": [
          "(10|十)台"
        ]
      },
      {
        "id": "unit_price",
        "desc": "单价 28 万元",
        "patterns": [
          "28万",
          "280,?000",
          "贰拾捌万"
        ]
      },
      {
        "id": "total",
        "desc": "总价 280 万元",
        "patterns": [
