[
  {
    "id": "lease_residential",
    "title": "个人住房租赁合同（上海·居住）",
    "contract_family": "房屋租赁",
    "requirement": "我是房东，需要起草一份房屋租赁合同，租给一位打工者，签约双方是个人对个人。房屋位于上海市松江区，合同复杂程度为标准型，使用场景为居住。租赁期限1年，月租金2500元，押一付三。需要包含允许养猫的宠物条款（一只），并明确宠物损坏墙面、家具的赔偿责任。违约金设置为2个月租金。要求明确非正常磨损（如地板划痕、电器损坏）的修复责任和赔偿标准，退租时需恢复原状。另外，加入提前退租违约金（提前30天通知，扣1个月租金）和逾期支付租金的宽限期（5天）。物业费由房东承担，水电燃气网费由租客承担，房屋内家具家电清单作为附件。",
    "elements": [
      {
        "id": "rent",
        "desc": "月租金 2500 元",
        "patterns": [
          "月租金[^。；\\n]{0,40}2500",
          "2500[^。；\\n]{0,10}元[^。；\\n]{0,20}(/月|每月)"
        ]
      },
      {
        "id": "deposit",
        "desc": "押一付三",
        "patterns": [
          "押一付三",
          "押1付3",
          "押金[^。]{0,60}(一|1)个月[^。]{0,80}(三|3)个月"
        ]
      },
      {
        "id": "term",
        "desc": "租期 1 年",
        "patterns": [
          "(租赁期限|租期)[^。]{0,30}(1|一)年",
          "(租赁期限|租期)[^。]{0,40}12个月"
        ]
      },
      {
        "id": "cat",
        "desc": "允许饲养一只猫",
        "patterns": [
          "(一|1)只猫",
          "饲养[^。]{0,20}猫"
        ]
      },
      {
        "id": "pet_damage",
        "desc": "宠物损坏墙面/家具赔偿",
        "patterns": [
          "(宠物|猫)[^。]{0,120}(墙面|家具)[^。]{0,120}(赔偿|修复|承担)",
          "(墙面|家具)[^。]{0,60}(宠物|猫)[^。]{0,120}(赔偿|修复|承担)"
        ]
      },
      {
        "id": "penalty",
        "desc": "违约金 2 个月租金",
        "patterns": [
          "违约金[^。]{0,80}(2|两|二)个月",
          "(2|两|二)个月租金[^。]{0,30}违约金"
        ]
      },
      {
        "id": "abnormal_wear",
        "desc": "非正常磨损修复责任",
        "patterns": [
          "非正常[^。]{0,10}(磨损|损耗|损坏|使用)",
          "(正常|合理)(使用|磨损|损耗)(以外|之外|除外)",
          "(使用|保管)不当[^。]{0,60}(损坏|损毁)[^。]{0,80}(修复|赔偿)"
        ]
      },
      {
        "id": "restore",
        "desc": "退租恢复原状",
        "patterns": [
          "恢复(至|到)?原状",
          "恢复(至|到)?(交付|原始|初始)(时)?(的)?状态"
        ]
      },
      {
        "id": "early_exit_notice",
        "desc": "提前退租提前 30 天通知",
        "patterns": [
          "提前(30|三十)(日|天)"
        ]
      },
      {
        "id": "early_exit_penalty",
        "desc": "提前退租扣 1 个月租金",
        "patterns": [
          "(提前退租|提前解除|提前终止|提前退房)[^。]{0,260}(1|一)个月(的)?租金",
          "(1|一)个月(的)?租金[^。]{0,40}(提前退租|提前解除|提前退房)"
        ]
      },
      {
        "id": "grace",
        "desc": "逾期支付宽限期 5 天",
        "patterns": [
          "宽限[^。]{0,20}(5|五)(日|天)",
          "(5|五)(日|天|个工作日)[^。]{0,10}宽限"
        ]
      },
      {
        "id": "property_fee",
        "desc": "物业费由出租方承担",
        "patterns": [
          "物业(服务)?费[^。]{0,60}(甲方|出租方|出租人)[^。]{0,20}(承担|缴纳|支付)",
          "(甲方|出租方|出租人)[^。]{0,40}(承担|缴纳|支付)[^。]{0,20}物业(服务)?费"
        ]
      },
      {
        "id": "utilities",
        "desc": "水电燃气网费由承租方承担",
        "patterns": [
          "(水|电|燃气|网络|网费)[^。]{0,60}(乙方|承租方|承租人)[^。]{0,20}(承担|缴纳|支付)",
          "(乙方|承租方|承租人)[^。]{0,40}(承担|缴纳|支付)[^。]{0,40}(水|电|燃气|网)"
        ]
      },
      {
        "id": "inventory_annex",
        "desc": "家具家电清单作为附件",
        "patterns": [
          "(家具|家电|物品)[^。]{0,40}(清单|明细)[^。]{0,60}附件",
          "附件[^。]{0,40}(家具|家电)"
        ]
      }
    ],
    "required_clauses": [
      {
        "id": "subject",
        "name": "租赁房屋（标的）",
        "patterns": [
          "租赁房屋|房屋(基本)?(情况|信息)|租赁标的|房屋坐落"
        ]
      },
      {
        "id": "term",
        "name": "租赁期限",
        "patterns": [
          "租赁期限|租期"
        ]
      },
      {
        "id": "rent",
        "name": "租金及支付",
        "patterns": [
          "租金[^。]{0,10}支付|支付方式|租金"
        ]
      },
      {
        "id": "deposit",
        "name": "押金",
        "patterns": [
          "押金|保证金"
        ]
      },
      {
        "id": "fees",
        "name": "相关费用承担",
        "patterns": [
          "费用(的)?承担|相关费用|物业(服务)?费"
        ]
      },
      {
        "id": "maintenance",
        "name": "房屋维修与使用",
        "patterns": [
          "维修|维护|修缮"
        ]
      },
      {
        "id": "sublease",
        "name": "转租/用途限制",
        "patterns": [
          "转租|用途"
        ]
      },
      {
        "id": "breach",
        "name": "违约责任",
        "patterns": [
          "违约责任|违约金"
        ]
      },
      {
        "id": "termination",
        "name": "合同解除/终止",
        "patterns": [
          "解除|终止"
        ]
      },
      {
        "id": "return",
        "name": "房屋返还",
        "patterns": [
          "返还|退租|交还"
        ]
      },
      {
        "id": "dispute",
        "name": "争议解决",
        "patterns": [
          "争议解决|争议的解决|管辖|仲裁|诉讼"
        ]
      },
      {
        "id": "signature",
        "name": "签署与生效",
        "patterns": [
          "签字|签章|盖章|生效"
        ]
      }
    ],
    "special_requirements": [
      "允许饲养一只猫，并明确宠物损坏墙面、家具的赔偿责任",
      "违约金为2个月租金",
      "明确非正常磨损的修复责任与赔偿标准，退租时恢复原状",
      "提前退租需提前30天通知并扣1个月租金",
      "逾期支付租金有5天宽限期",
      "物业费由房东承担，水电燃气网费由租客承担",
      "家具家电清单作为附件"
    ]
  },
  {
    "id": "tech_service_ops",
    "title": "软件运维技术服务合同（北京·企业对企业）",
    "contract_family": "技术服务",
    "requirement": "我们是一家制造企业（甲方），要和一家IT公司（乙方）签订软件系统运维技术服务合同，企业对企业，北京地区，标准复杂度。服务期2年，年服务费36万元，按季度支付，每季度末支付9万元。要求7×24小时响应，一级故障2小时内响应、8小时内恢复；乙方每月提交运维报告；服务可用率不低于99.9%，未达标按当季服务费的5%扣减；乙方需对甲方数据保密，保密期限为合同终止后3年；违约金为合同总额的20%；争议提交北京仲裁委员会仲裁。",
    "elements": [
      {
        "id": "term",
        "desc": "服务期 2 年",
        "patterns": [
          "(服务期|服务期限|合同期限)[^。]{0,30}(2|两|二)年",
          "(服务期|服务期限)[^。]{0,40}24个月"
        ]
      },
      {
        "id": "annual_fee",
        "desc": "年服务费 36 万元",
        "patterns": [
          "36万",
          "360,?000",
          "叁拾陆万"
        ]
      },
      {
        "id": "quarterly",
        "desc": "按季度支付 9 万元",
        "patterns": [
          "(9|九)万",
          "90,?000"
        ]
      },
      {
        "id": "7x24",
        "desc": "7×24 小时响应",
        "patterns": [
          "7\\s*[×xX*]\\s*24",
          "全天候"
        ]
      },
      {
        "id": "resp_2h",
        "desc": "一级故障 2 小时内响应",
        "patterns": [
          "(2|两|二)(个)?小时(内|以内)?[^。]{0,10}响应",
          "响应[^。]{0,20}(2|两|二)(个)?小时"
        ]
      },
      {
        "id": "restore_8h",
        "desc": "8 小时内恢复",
        "patterns": [
          "(8|八)(个)?小时(内|以内)?[^。]{0,10}(恢复|修复|解决)",
          "(恢复|修复|解决)[^。]{0,20}(8|八)(个)?小时"
        ]
      },
      {
        "id": "monthly_report",
        "desc": "每月提交运维报告",
        "patterns": [
          "(每月|月度|按月)[^。]{0,30}(运维)?报告"
        ]
      },
      {
        "id": "sla",
        "desc": "可用率 ≥99.9%",
        "patterns": [
          "99\\.9\\s*%"
        ]
      },
      {
        "id": "sla_penalty",
        "desc": "未达标扣减当季服务费 5%",
        "patterns": [
          "(5|五)\\s*%[^。]{0,40}(扣减|扣除)",
          "(扣减|扣除)[^。]{0,60}(5|五)\\s*%",
          "百分之五"
        ]
      },
      {
        "id": "conf_3y",
        "desc": "保密期限为终止后 3 年",
        "patterns": [
          "(终止|届满|结束)[^。]{0,30}(3|三)年",
          "保密期限[^。]{0,40}(3|三)年"
        ]
      },
      {
        "id": "penalty_20",
        "desc": "违约金为合同总额 20%",
        "patterns": [
          "20\\s*%",
          "百分之二十"
        ]
      },
      {
        "id": "arbitration",
        "desc": "北京仲裁委员会仲裁",
        "patterns": [
          "北京仲裁委员会"
        ]
      }
    ],
    "required_clauses": [
      {
        "id": "scope",
        "name": "服务内容与范围",
        "patterns": [
          "服务(内容|范围|事项)"
        ]
      },
      {
        "id": "term",
        "name": "服务期限",
        "patterns": [
          "服务期限|服务期|合同期限"
        ]
      },
      {
        "id": "fee",
        "name": "服务费用与支付",
        "patterns": [
          "服务费|费用[^。]{0,6}支付|付款"
        ]
      },
      {
        "id": "sla",
        "name": "服务标准/SLA",
        "patterns": [
          "服务(标准|水平|质量)|SLA|可用率|响应"
        ]
      },
      {
        "id": "rights",
        "name": "双方权利义务",
        "patterns": [
          "权利(和|与|及)?义务|甲方(的)?(义务|责任)|乙方(的)?(义务|责任)"
        ]
      },
      {
        "id": "acceptance",
        "name": "考核/验收",
        "patterns": [
