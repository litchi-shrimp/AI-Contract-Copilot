        ]
      },
      {
        "id": "scope",
        "name": "授权范围（地域/期限/用途）",
        "patterns": [
          "授权范围|授权(地域|区域|期限)|使用范围"
        ]
      },
      {
        "id": "fee",
        "name": "费用结算/分成",
        "patterns": [
          "结算|分成|费用"
        ]
      },
      {
        "id": "restriction",
        "name": "使用限制",
        "patterns": [
