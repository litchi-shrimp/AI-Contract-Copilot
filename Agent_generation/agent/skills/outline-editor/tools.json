  {
    "file": "delete_clause.py",
    "name": "delete_clause",
    "description": "删除指定条款内容，支持单个或批量删除。批量删除时自动按 locator 降序执行，避免 locator 偏移冲突。",
    "parameters": {
      "type": "object",
      "properties": {
        "locator": {
          "oneOf": [
            {
              "type": "string",
              "description": "单个节点定位标识。格式为数字层级定位，如\"1\"（章节级）、\"1.1\"（条款级）、\"1.1.1\"（子条款级）、\"1.1.1.1\"（子子条款级）。"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "locator 列表，支持跨级别批量删除。自动按深层优先→数值降序执行，无需考虑 locator 偏移问题。"
            }
          ],
          "description": "节点定位标识，可传入单个字符串或 locator 列表"
        }
      },
      "required": [
        "locator"
      ]
    },
    "return": {
      "type": "string",
      "description": "操作结果"
    }
  },
  {
    "file": "insert_clause.py",
    "name": "insert_clause",
    "description": "插入新条款内容，支持批量插入。批量操作时会自动排序，无需考虑 locator 偏移问题。",
    "parameters": {
      "type": "object",
      "properties": {
        "locators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "（批量模式）参考节点定位标识列表。如[\"5.1\", \"6.3\", \"7.1\"]"
        },
        "contents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "（批量模式）插入的条款内容列表，与 locators 一一对应"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "before",
              "after",
              "child"
            ]
          },
          "description": "（批量模式）插入位置列表，与 locators 一一对应"
        }
      },
      "required": []
    },
    "return": {
      "type": "string",
      "description": "操作结果"
    }
  },
