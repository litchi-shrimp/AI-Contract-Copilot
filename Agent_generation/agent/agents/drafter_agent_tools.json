[
    {
        "file": "update_clause.py",
        "name": "update_clause",
        "description": "更新指定条款内容，支持多个locator批量操作",
        "parameters": {
            "type": "object",
            "properties": {
                "locator": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "description": "多个节点定位标识"
                    },
                    "description": "locator列表，用于批量更新多个节点。如[‘1.1’，‘1.2’，‘1.3’] 或['3.4.1', '3.4.1', '3.4.2']"
                },
                "content": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "description": "新内容（禁止出现标号，直接修改文本即可）"
                    },
                    "description": "内容列表，与locator一一对应"
                }
            },
            "required": [
                "locator",
                "content"
            ]
        },
        "return": {
            "type": "string",
            "description": "操作结果"
        }
    },
    {
        "file": "insert_clause.py",
        "name": "insert_clause",
        "description": "插入新条款内容，支持批量插入。批量操作时会自动排序，无需考虑 locator 偏移问题。尽量一次性批量插入，更高效",
        "parameters": {
            "type": "object",
            "properties": {
                "locators": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "（批量模式）参考节点定位标识列表。如[\"5.1\", \"6.3\", \"7.1\"]"
                },
                "contents": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "（批量模式）插入的条款内容列表，与 locators 一一对应"
                },
                "positions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "before",
                            "after",
                            "child"
                        ]
                    },
                    "description": "（批量模式）插入位置列表，与 locators 一一对应"
                }
            },
            "required": []
        },
        "return": {
            "type": "string",
            "description": "操作结果"
        }
    },
    {
        "file": "update_header_footer.py",
        "name": "update_header_footer",
        "description": "整体替换或获取合同首部/尾部内容。合同首部和尾部是整体文本段落，不通过数字locator定位，通过 target 参数区分操作目标。",
        "parameters": {
            "type": "object",
            "properties": {
                "target": {
                    "type": "string",
                    "enum": [
                        "header",
                        "footer"
                    ],
                    "description": "操作目标：'header' 表示合同首部，'footer' 表示合同尾部"
                },
                "content": {
                    "type": "string",
                    "description": "替换后的完整内容（operation 为 'update' 时必填）"
                },
                "operation": {
                    "type": "string",
                    "enum": [
                        "update"
                    ],
                    "description": "操作类型：'update' 更新内容。"
                }
            },
            "required": [
                "target",
                "operation"
            ]
        },
        "return": {
            "type": "string",
            "description": "操作结果"
        }
    },
    {
        "file": "retrieve_template_reference.py",
        "name": "retrieve_template_reference",
        "description": "从模板库中检索与用户需求相关的参考内容，使用关键词检索算法。如果第一次检索未找到相关内容，会尝试使用不同的关键词重新检索（最多重试2次）。",
        "parameters": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "description": "用户的需求描述或问题"
                },
                "top_k": {
                    "type": "integer",
                    "description": "返回的相关结果数量，默认为5",
                    "default": 5
                }
            },
            "required": [
                "query"
            ]
        },
        "return": {
            "type": "string",
            "description": "相关模板内容列表，包含章节编号、标题和条款内容"
        }
    },
    {
        "file": "web_search.py",
        "name": "web_search",
        "description": "当模板检索无法找到相关内容时，使用网络搜索获取参考信息。该工具会提取用户问题中的法律相关关键词进行搜索，并结合当前大纲结构提供建议。",
        "parameters": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "description": "用户的需求描述或问题，格式[合同类型] + [具体条款主题] + [检索意图后缀]，例如:技术开发合同 验收标准 必要构成"
                }
            },
            "required": [
                "query"
            ]
        },
        "return": {
            "type": "string",
            "description": "网络搜索结果，包含相关参考信息和当前大纲结构"
        }
    }
]